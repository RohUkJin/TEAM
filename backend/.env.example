NODE_ENV=development
PORT=4000

# Frontend origin allowed by CORS (no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL (Docker Compose host port example: 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fullstack_study

# Email verification token lifetime (hours)
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# Email transport: console (dev log) | resend (real send)
EMAIL_TRANSPORT=console
# Required when EMAIL_TRANSPORT=resend (never commit real keys)
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=TEAM <onboarding@resend.dev>
# production requires EMAIL_TRANSPORT=resend

# JWT (do not commit real production secrets)
JWT_SECRET=replace-with-long-random-secret
# Access token TTL (seconds). Default 900 = 15 minutes
JWT_EXPIRES_IN_SECONDS=900
# Refresh token TTL (seconds). Default 604800 = 7 days
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800

# Cookie security
# - development(local HTTP): COOKIE_SECURE=false (default when unset in development)
# - production(HTTPS): COOKIE_SECURE=true  (required — server refuses to start otherwise)
# COOKIE_SAMESITE: lax | strict | none  (none requires Secure=true)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
