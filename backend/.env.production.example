# Production example — copy values into your host/secrets manager.
# Requires HTTPS. Do not use these placeholders as-is.

NODE_ENV=production
PORT=4000

FRONTEND_ORIGIN=https://your-frontend.example.com
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/fullstack_study

EMAIL_VERIFICATION_EXPIRES_HOURS=24

# Real email delivery
EMAIL_TRANSPORT=resend
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=TEAM <noreply@yourdomain.com>

JWT_SECRET=replace-with-long-random-production-secret
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800

# HTTPS required
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
