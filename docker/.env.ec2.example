# AWS EC2 데모 배포용 (도메인/HTTPS 연결 전). 실제 .env로 복사한 뒤 PUBLIC_IP를 치환한다.
# 운영(HTTPS) 전환 시에는 production + COOKIE_SECURE=true + Resend 설정을 별도로 적용해야 한다.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-db-password
POSTGRES_DB=fullstack_study
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=4000
FRONTEND_HOST_PORT=3000

# HTTP 데모이므로 애플리케이션의 HTTPS 강제 검증을 피하기 위해 development를 사용한다.
NODE_ENV=development
FRONTEND_ORIGIN=http://PUBLIC_IP
NEXT_PUBLIC_API_BASE_URL=http://PUBLIC_IP/api
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800
EMAIL_VERIFICATION_EXPIRES_HOURS=24
EMAIL_TRANSPORT=console
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
