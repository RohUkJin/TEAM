POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fullstack_study
POSTGRES_HOST_PORT=5433

BACKEND_HOST_PORT=4000
FRONTEND_HOST_PORT=3000

# 로컬 Docker: development 이면 가입 응답에 인증 토큰 포함
NODE_ENV=development

FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

JWT_SECRET=dev-only-change-me-fullstack-study-jwt-secret
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# local default: console. For real mail in Docker, set resend + key.
EMAIL_TRANSPORT=console
# RESEND_API_KEY=
# EMAIL_FROM=TEAM <onboarding@resend.dev>

# local HTTP
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- production checklist (when deploying with HTTPS) ---
# NODE_ENV=production
# FRONTEND_ORIGIN=https://your-frontend.example.com
# NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com/api
# JWT_SECRET=<long-random-secret>
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# EMAIL_TRANSPORT=resend
# RESEND_API_KEY=<resend-api-key>
# EMAIL_FROM=TEAM <noreply@yourdomain.com>